# Local database used for the interview/demo build.
DATABASE_URL=sqlite:///./library.db

# Required for chatbot intent detection and generated responses.
# Create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Local interview/demo settings. Change these before any real deployment.
ALLOW_DEMO_PASSWORD_RESET=true
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=change_this_admin_password
